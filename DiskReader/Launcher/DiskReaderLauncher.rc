#include <winver.h>
#include <winuser.h>

#ifdef LAUNCHER_TEST
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DiskReaderLauncher.test.manifest"
#else
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DiskReaderLauncher.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,0,0,0
 PRODUCTVERSION 4,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IcyModz420"
            VALUE "FileDescription", "X360GameHack Disk Reader"
            VALUE "FileVersion", "4.0.0.0"
            VALUE "InternalName", "X360GameHack.DiskReader"
            VALUE "OriginalFilename", "X360GameHack.DiskReader.exe"
            VALUE "ProductName", "X360GameHack 2026"
            VALUE "ProductVersion", "4.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
